<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form">

    <Dialog
        id="addProductDialog"
        title="Add Product"
        draggable="true"
        resizable="true"
        contentWidth="500px">

        <content>
            <form:SimpleForm
                editable="true"
                layout="ResponsiveGridLayout"
                labelSpanXL="3"
                labelSpanL="3"
                labelSpanM="3"
                labelSpanS="12"
                columnsXL="1"
                columnsL="1"
                columnsM="1">

                <Label text="Product ID"/>
                <Input value="{newProduct>/productId}"/>

                <Label text="Name"/>
                <Input value="{newProduct>/name}"/>

                <Label text="Category"/>
                <Input value="{newProduct>/category}"/>

                <Label text="SKU"/>
                <Input value="{newProduct>/sku}"/>

                <Label text="Price"/>
                <Input
                    value="{newProduct>/price}"
                    type="Number"/>

                <Label text="Currency"/>
                <Select selectedKey="{newProduct>/currency}">
                    <items>
                        <core:Item key="USD" text="USD"/>
                        <core:Item key="EUR" text="EUR"/>
                        <core:Item key="INR" text="INR"/>
                    </items>
                </Select>

                <Label text="Stock"/>
                <Input
                    value="{newProduct>/stock}"
                    type="Number"/>

                <Label text="Reorder Threshold"/>
                <Input
                    value="{newProduct>/reorderThreshold}"
                    type="Number"/>

                <Label text="Supplier"/>
                <Input value="{newProduct>/supplier}"/>

                <Label text="Warehouse"/>
                <Input value="{newProduct>/warehouse}"/>

                <Label text="Description"/>
                <TextArea
                    value="{newProduct>/description}"
                    rows="3"/>

                <Label text="Image URL"/>
                <Input value="{newProduct>/imageUrl}"/>

            </form:SimpleForm>
        </content>

        <beginButton>
            <Button
                text="Submit"
                type="Emphasized"
                press=".onSaveProduct"/>
        </beginButton>

        <endButton>
            <Button
                text="Cancel"
                press=".onCancelProduct"/>
        </endButton>

    </Dialog>

</core:FragmentDefinition>